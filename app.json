{
  "expo": {
    "name": "SHEconomy",
    "slug": "sheconomy",
    "owner": "sheconomy",
    "version": "6.0",
    "scheme": "sheconomy",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android"
    ],
    "runtimeVersion": "6.0",
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/61412da1-9fab-4374-83f5-9e7eba296400"
    },
    "plugins": [
      "./plugins/withUniversalDeviceSupport.cjs",
      "./plugins/withGoogleModularHeaders.cjs",
      "./plugins/withCallKeep.cjs",
      "./plugins/withAndroidFgsCompliance.cjs",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          }
        }
      ],
      [
        "onesignal-expo-plugin",
        {
          "mode": "development",
          "disableLocation": true
        }
      ],
      "one/expo-plugin",
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication",
            "enableScreenShareService": true
          }
        }
      ],
      [
        "expo-livekit-screen-share",
        {
          "ios": {
            "extensionName": "ScreenShareExtension",
            "appGroupIdentifier": "group.com.sheconomy.ecommerce"
          },
          "android": {
            "enableScreenShareService": true,
            "foregroundServicePermission": true
          }
        }
      ],
      "expo-font",
      "expo-localization",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SHEconomy to access your photos to upload listing images and shop logos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SHEconomy to use your camera for video meetings and face liveness verification.",
          "microphonePermission": "Allow SHEconomy to use your microphone for video meetings and live captions.",
          "recordAudioAndroid": true
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-local-authentication",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow access so you can select contacts to connect with people you know. SHEconomy only uploads the contacts you choose."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow SHEconomy to use your location to autofill delivery addresses, check PIN availability, and show nearby shops. Precise location is optional.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "@react-native-voice/voice",
        {
          "microphonePermission": "Allow SHEconomy to use the microphone for video meetings and live captions.",
          "speechRecognitionPermission": "Allow SHEconomy to convert speech to live captions in meetings."
        }
      ]
    ],
    "icon": "./public/app-icon.png",
    "splash": {
      "image": "./public/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#D81B60"
    },
    "ios": {
      "bundleIdentifier": "com.sheconomy.ecommerce",
      "buildNumber": "102",
      "appleTeamId": "52H73QK4CL",
      "supportsTablet": true,
      "requireFullScreen": false,
      "usesAppleSignIn": true,
      "icon": "./public/app-icon.png",
      "associatedDomains": [
        "applinks:sheconomy.in"
      ],
      "infoPlist": {
        "CFBundleDisplayName": "SHEconomy",
        "UIBackgroundModes": [
          "audio",
          "voip",
          "remote-notification"
        ],
        "NSFaceIDUsageDescription": "Unlock SHEconomy with Face ID when biometric unlock is enabled.",
        "NSContactsUsageDescription": "Allow access so you can select contacts to connect with people you know. SHEconomy only uploads the contacts you choose.",
        "NSLocationWhenInUseUsageDescription": "Allow SHEconomy to use your location to autofill delivery addresses, check PIN availability, and show nearby shops. Precise location is optional.",
        "UIDeviceFamily": [
          1,
          2,
          1,
          2
        ],
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight",
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight",
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "RTCScreenSharingExtension": "com.sheconomy.ecommerce.ScreenShareExtension",
        "RTCAppGroupIdentifier": "group.com.sheconomy.ecommerce"
      }
    },
    "android": {
      "package": "com.sheconomy.ecommerce",
      "versionCode": 117,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./public/app-icon.png",
        "backgroundColor": "#D81B60"
      },
      "icon": "./public/app-icon.png",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "sheconomy.in",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_PHONE_CALL",
        "android.permission.MANAGE_OWN_CALLS",
        "android.permission.READ_PHONE_STATE",
        "android.permission.READ_PHONE_NUMBERS",
        "android.permission.CALL_PHONE",
        "android.permission.USE_FULL_SCREEN_INTENT"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "61412da1-9fab-4374-83f5-9e7eba296400",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "OneSignalNotificationServiceExtension",
                  "bundleIdentifier": "com.sheconomy.ecommerce.OneSignalNotificationServiceExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.sheconomy.ecommerce.onesignal"
                    ]
                  }
                },
                {
                  "targetName": "ScreenShareExtension",
                  "bundleIdentifier": "com.sheconomy.ecommerce.ScreenShareExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.sheconomy.ecommerce"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
