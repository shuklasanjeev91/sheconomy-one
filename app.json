{
  "expo": {
    "name": "sheconomy-one",
    "slug": "sheconomy-one",
    "scheme": "sheconomy",
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "one/expo-plugin",
      "@livekit/react-native-expo-plugin",
      "expo-font",
      "expo-localization",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SHEconomy to access your photos to upload listing images and shop logos."
        }
      ]
    ],
    "icon": "./public/app-icon.png",
    "splash": {
      "image": "./public/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "bundleIdentifier": "com.sheconomy.one",
      "associatedDomains": [
        "applinks:sheconomy-one-sanjeev-shuklas-projects.vercel.app"
      ]
    },
    "android": {
      "package": "com.sheconomy.one",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "sheconomy-one-sanjeev-shuklas-projects.vercel.app",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    }
  }
}
