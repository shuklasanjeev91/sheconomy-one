{
  "expo": {
    "name": "sheconomy-one",
    "slug": "sheconomy-one",
    "scheme": "sheconomy",
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "./plugins/withUniversalDeviceSupport.cjs",
      [
        "onesignal-expo-plugin",
        {
          "mode": "development",
          "disableLocation": true
        }
      ],
      "one/expo-plugin",
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication",
            "enableScreenShareService": true
          }
        }
      ],
      [
        "expo-livekit-screen-share",
        {
          "ios": {
            "extensionName": "ScreenShareExtension",
            "appGroupIdentifier": "group.com.sheconomy.one"
          },
          "android": {
            "enableScreenShareService": true,
            "foregroundServicePermission": true
          }
        }
      ],
      "expo-font",
      "expo-localization",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SHEconomy to access your photos to upload listing images and shop logos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SHEconomy to use your camera for face liveness verification.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "icon": "./public/app-icon.png",
    "splash": {
      "image": "./public/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "bundleIdentifier": "com.sheconomy.one",
      "supportsTablet": true,
      "requireFullScreen": false,
      "associatedDomains": [
        "applinks:sheconomy-one-sanjeev-shuklas-projects.vercel.app"
      ],
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSUserTrackingUsageDescription": "This permission is used to deliver personalized push notifications.",
        "UIDeviceFamily": [
          1,
          2
        ],
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "android": {
      "package": "com.sheconomy.one",
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "sheconomy-one-sanjeev-shuklas-projects.vercel.app",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    }
  }
}
