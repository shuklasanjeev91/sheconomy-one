{
  "expo": {
    "name": "sheconomy-one",
    "slug": "sheconomy-one",
    "scheme": "sheconomy",
    "platforms": ["ios", "android"],
    "plugins": [
      "one/expo-plugin",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc"
    ],
    "icon": "./public/app-icon.png",
    "splash": {
      "image": "./public/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "bundleIdentifier": "com.sheconomy.one",
      "associatedDomains": [
        "applinks:sheconomy-one-sanjeev-shuklas-projects.vercel.app"
      ]
    },
    "android": {
      "package": "com.sheconomy.one",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "sheconomy-one-sanjeev-shuklas-projects.vercel.app",
              "pathPrefix": "/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    }
  }
}
