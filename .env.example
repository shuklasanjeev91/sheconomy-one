# Supabase — sheconomy_db (project ref: zsaqrrzwygzwrlzgymxk)
EXPO_PUBLIC_SUPABASE_URL=https://zsaqrrzwygzwrlzgymxk.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Canonical web origin — ties web, iOS, and Android together (share links, deep links, WebViews)
ONE_SERVER_URL=https://sheconomy-one-sanjeev-shuklas-projects.vercel.app
EXPO_PUBLIC_WEB_APP_URL=https://sheconomy-one-sanjeev-shuklas-projects.vercel.app

# App environment label (development | preview | production)
EXPO_PUBLIC_APP_ENV=development

# Optional Android SMS Retriever app hash (11 chars) for OTP SMS templates — never use READ_SMS
EXPO_PUBLIC_ANDROID_SMS_HASH=

# Remote OTA / maintenance policy JSON endpoint (see docs/AUTOMATIC_UPDATES.md)
# Example response:
# {"minimumSupportedVersion":"1.20.0","latestVersion":"1.20.1","critical":false,"maintenanceMode":false}
EXPO_PUBLIC_UPDATE_CONFIG_URL=

# Store links used when a native binary is below minimumSupportedVersion
EXPO_PUBLIC_IOS_APP_STORE_URL=
EXPO_PUBLIC_ANDROID_PLAY_STORE_URL=

# OneSignal (public app id — safe for client; REST key stays server-only)
EXPO_PUBLIC_ONESIGNAL_APP_ID=your-onesignal-app-id
# Server secrets (Supabase Dashboard / CLI — never ship to clients):
# ONESIGNAL_APP_ID=...
# ONESIGNAL_REST_API_KEY=...
# RESEND_API_KEY=...
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=...
# TWILIO_WHATSAPP_FROM=...
# NOTIFICATION_CRON_SECRET=...
# OPENAI_API_KEY=...          # required by ai-assist edge function (real answers)
# OPENAI_MODEL=gpt-4o-mini    # optional; defaults to gpt-4o-mini

# LiveKit — fetched at runtime from sheconomy_db edge functions (no client secrets)
# livekit-config  → public URL + enabled flag + max participants
# livekit-token   → JWT token for joining a meeting room
# Server secrets on Supabase (dashboard / CLI):
#   LIVEKIT_URL, LIVEKIT_API_KEY, LIVEKIT_API_SECRET, LIVEKIT_MAX_PARTICIPANTS
