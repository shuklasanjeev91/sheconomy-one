EXPO_PUBLIC_WEB_APP_URL=https://sheconomy-one-sanjeev-shuklas-projects.vercel.app

# LiveKit — fetched at runtime from sheconomy_db edge functions (no client secrets)
# livekit-config  → public URL + enabled flag + max participants
# livekit-token   → JWT token for joining a meeting room
# Server secrets on Supabase (dashboard / CLI):
#   LIVEKIT_URL, LIVEKIT_API_KEY, LIVEKIT_API_SECRET, LIVEKIT_MAX_PARTICIPANTS
