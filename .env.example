# Supabase — sheconomy_db (project ref: zsaqrrzwygzwrlzgymxk)
EXPO_PUBLIC_SUPABASE_URL=https://zsaqrrzwygzwrlzgymxk.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional owned AI service. When set, chat, search, and commerce rails call it
# before the Gemini edge function and SQL recommendation RPCs.
# Public SHERPA URL. Local development can use http://127.0.0.1:8787.
# EXPO_PUBLIC_AI_SERVICE_URL=https://d314vqsvc8rb4h.cloudfront.net

# Canonical web origin — ties web, iOS, and Android together (share links, deep links, WebViews)
ONE_SERVER_URL=https://sheconomy.in
EXPO_PUBLIC_WEB_APP_URL=https://sheconomy.in

# App environment label (development | preview | production)
EXPO_PUBLIC_APP_ENV=development

# External analytics (ported from legacy sheconomy website). Enabled in production
# automatically; set true to test in development.
# EXPO_PUBLIC_ENABLE_EXTERNAL_ANALYTICS=true
# EXPO_PUBLIC_GOOGLE_TAG_MANAGER_ID=GTM-5Q46HTDR
# EXPO_PUBLIC_GOOGLE_ANALYTICS_ID=G-ZQWD6CCEPY
# EXPO_PUBLIC_META_PIXEL_ID=871397487664970
# EXPO_PUBLIC_CLARITY_PROJECT_ID=vgpk0whxnd

# Optional Android SMS Retriever app hash (11 chars) for OTP SMS templates — never use READ_SMS
EXPO_PUBLIC_ANDROID_SMS_HASH=

# Remote OTA / maintenance policy JSON endpoint (see docs/AUTOMATIC_UPDATES.md)
# Example response:
# {"minimumSupportedVersion":"1.20.0","latestVersion":"1.20.1","critical":false,"maintenanceMode":false}
EXPO_PUBLIC_UPDATE_CONFIG_URL=

# Store links used when a native binary is below minimumSupportedVersion
EXPO_PUBLIC_IOS_APP_STORE_URL=
EXPO_PUBLIC_ANDROID_PLAY_STORE_URL=

# OneSignal (public app id — safe for client; REST key stays server-only)
# Google Sign-In / One Tap / native email hint (Web OAuth client ID from Google Cloud)
# Required for native Google ID-token sign-in and "Use email from this device"
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=123456789-yyyy.apps.googleusercontent.com

EXPO_PUBLIC_ONESIGNAL_APP_ID=your-onesignal-app-id
# Preferred: clients load App ID from edge function `onesignal-config`
# (Supabase secret ONESIGNAL_APP_ID). Env above is a local fallback only.
# Server secrets (Supabase Dashboard / CLI — never ship REST key to clients):
# ONESIGNAL_APP_ID=...
# ONESIGNAL_REST_API_KEY=...
# ONESIGNAL_SAFARI_WEB_ID=...
# RESEND_API_KEY=...
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=...
# TWILIO_WHATSAPP_FROM=...
# NOTIFICATION_CRON_SECRET=...
# GEMINI_API_KEY=...          # required by ai-assist + visual-commerce (Google AI Studio)
# GEMINI_MODEL=gemini-2.5-pro # optional; defaults to gemini-2.5-pro (chat/text)
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image  # optional; try-on / view-in-space
# GOOGLE_AI_API_KEY=...       # optional alias for GEMINI_API_KEY
# GOOGLE_AI_MODEL=...         # optional alias for GEMINI_MODEL
# EXPO_PUBLIC_VISUAL_PREVIEW_ENABLED=true  # set false to hide Try on / View in room CTAs
# EXCHANGE_RATE_API_KEY=...   # ExchangeRate-API.com key for exchange-rates edge function
# COMMERCE_PAYMENT_WEBHOOK_SECRET=...  # HMAC for commerce-payment-webhook

# Playwright smoke — multi-tier auth (optional; guest smoke always runs).
# Path A: paste access_token + refresh_token from browser localStorage
#   sb-zsaqrrzwygzwrlzgymxk-auth-token after OTP sign-in. Never commit values.
# Path C: set SUPABASE_SERVICE_ROLE_KEY then run `yarn smoke:mint`
# See tests/smoke/README.md
# SUPABASE_SERVICE_ROLE_KEY=
# SMOKE_LIMITED_ACCESS_TOKEN=
# SMOKE_LIMITED_REFRESH_TOKEN=
# SMOKE_VERIFIED_ACCESS_TOKEN=
# SMOKE_VERIFIED_REFRESH_TOKEN=
# SMOKE_VENDOR_ACCESS_TOKEN=
# SMOKE_VENDOR_REFRESH_TOKEN=
# SMOKE_ADMIN_ACCESS_TOKEN=
# SMOKE_ADMIN_REFRESH_TOKEN=
# SMOKE_LIMITED_USER_ID=
# SMOKE_VERIFIED_USER_ID=
# SMOKE_VENDOR_USER_ID=
# SMOKE_ADMIN_USER_ID=
# PLAYWRIGHT_BASE_URL=http://localhost:8081
# PLAYWRIGHT_SKIP_WEBSERVER=1

# LiveKit — fetched at runtime from sheconomy_db edge functions (no client secrets)
# livekit-config  → public URL + enabled flag + max participants
# livekit-token   → JWT token for joining a meeting room
# livekit-recording → host start/stop/reconcile for RoomComposite cloud recordings
# livekit-egress-webhook → verified LiveKit egress lifecycle updates
# meeting-recording-share → revocable host share links + signed playback URLs
# Server secrets on Supabase (dashboard / CLI):
#   LIVEKIT_URL, LIVEKIT_API_KEY, LIVEKIT_API_SECRET, LIVEKIT_MAX_PARTICIPANTS
# Recordings are stored in the Supabase Storage bucket `meeting-recordings`
# (private). LiveKit Egress uploads through Supabase's S3-compatible endpoint,
# so generate S3 access keys in Supabase Dashboard → Storage → S3 access keys:
#   SUPABASE_S3_ACCESS_KEY_ID=...
#   SUPABASE_S3_SECRET_ACCESS_KEY=...
#   SUPABASE_STORAGE_REGION=ap-south-1   (project region; optional)
#   MEETING_RECORDINGS_BUCKET=meeting-recordings   (optional override)
#   PUBLIC_APP_URL=https://your-app-origin
# LiveKit Cloud webhook URL:
#   https://<project-ref>.supabase.co/functions/v1/livekit-egress-webhook
