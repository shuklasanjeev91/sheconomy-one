{
  "installCommand": "node .yarn/releases/yarn-4.17.0.cjs install --immutable",
  "buildCommand": "node .yarn/releases/yarn-4.17.0.cjs build",
  "build": {
    "env": {
      "ONE_SERVER_URL": "https://sheconomy-one-sanjeev-shuklas-projects.vercel.app",
      "EXPO_PUBLIC_WEB_APP_URL": "https://sheconomy-one-sanjeev-shuklas-projects.vercel.app"
    }
  },
  "cleanUrls": true,
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
